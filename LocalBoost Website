<style>
:root{--bg:#F3F5F8;--card:#fff;--ink:#0B2A45;--muted:#52667D;--line:#DDE3EC;--navy:#0B2A45;--navy2:#15405F;--blue:#1F6FEB;--green:#19B483;--orange:#F7931E;--on:#F2F7FF;--on2:#B4C6DA;--f:'Carlito','Calibri','Segoe UI',system-ui,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#071A2B;--card:#0F2B45;--ink:#EAF1FB;--muted:#9FB3CE;--line:#1D3C5A}}
:root[data-theme="dark"]{--bg:#071A2B;--card:#0F2B45;--ink:#EAF1FB;--muted:#9FB3CE;--line:#1D3C5A}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:76px}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.6 var(--f)}
img{max-width:100%;display:block}a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:6px}
.wrap{width:min(1120px,100% - 36px);margin-inline:auto}
section{padding:76px 0}
h1,h2,h3{line-height:1.12;letter-spacing:-.02em;margin:0}
h2{font-size:clamp(28px,4vw,42px);margin-bottom:12px}
.kick{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);margin:0 0 10px}
.sub{color:var(--muted);max-width:40em;margin:0 0 36px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:999px;font:700 17px var(--f);text-decoration:none;border:2px solid transparent;cursor:pointer;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.b-or{background:var(--orange);color:#fff}.b-gr{background:var(--green);color:#fff}.b-ln{border-color:rgba(242,247,255,.45);color:var(--on)}
/* nav */
.nav{position:sticky;top:0;z-index:20;background:var(--navy);padding-top:env(safe-area-inset-top,0)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{background:#fff;border-radius:10px;padding:6px 12px;display:flex}.logo img{height:30px;width:auto}
.nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0}
.nav ul a{color:var(--on2);text-decoration:none;font-weight:700;font-size:16px}.nav ul a:hover{color:#fff}
.nav .btn{padding:9px 18px;font-size:15px}
/* hero */
.hero{background:radial-gradient(900px 480px at 85% 0,#1B4A75 0,transparent 65%),var(--navy);color:var(--on);padding:64px 0 72px}
.hero .wrap{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(36px,5.4vw,62px);margin-bottom:18px}
.hero p{color:var(--on2);font-size:20px;max-width:30em;margin:0 0 28px}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.tag{color:var(--green);font-weight:700;font-size:20px;margin-bottom:14px}
.fan{position:relative;aspect-ratio:1/1.05;max-width:480px;margin-inline:auto;width:100%}
.fan img{position:absolute;width:44%;border-radius:16px;box-shadow:0 26px 50px -16px rgba(0,0,0,.6)}
.fan .a{left:0;top:14%;transform:rotate(-8deg)}.fan .b{left:28%;top:0;z-index:2;width:46%}.fan .c{right:0;top:16%;transform:rotate(7deg)}
/* cards */
.grid{display:grid;gap:20px}
.g4{grid-template-columns:repeat(4,1fr)}.g3{grid-template-columns:repeat(3,1fr)}.g2{grid-template-columns:repeat(2,1fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px}
.card h3{font-size:21px;margin-bottom:8px}.card p{margin:0;color:var(--muted);font-size:16.5px}
.ico{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:20px;margin-bottom:14px}
.about{background:var(--card);border-block:1px solid var(--line)}
.about .wrap{display:grid;grid-template-columns:1.2fr 1fr;gap:48px}
.mission{background:var(--navy);color:var(--on);border-radius:20px;padding:28px}
.mission p{color:var(--on2);margin:8px 0 0}.mission h3{font-size:26px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.chip{padding:8px 16px;border-radius:999px;background:var(--bg);border:1px solid var(--line);font-weight:700;font-size:16px}
/* gallery */
.gal{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 18px;align-items:start}
.gal figure{margin:0}.gal .w{grid-column:span 2}
.gal img{width:100%;height:auto;border-radius:14px;box-shadow:0 16px 32px -20px rgba(11,42,69,.6);background:var(--card)}
.gal figcaption{padding:8px 2px 0;font-weight:700;font-size:17px}
.gal figcaption span{display:block;font-weight:400;color:var(--muted);font-size:15px}
.note{border-left:4px solid var(--orange);padding:4px 0 4px 14px;color:var(--muted);font-size:16px;max-width:44em;margin:30px 0 0}
/* plans */
.plans .card{display:flex;flex-direction:column}
.plans .pop{border:2px solid var(--green)}
.plans ul{margin:14px 0 0;padding:0;list-style:none;display:grid;gap:9px}
.plans li{padding-left:28px;position:relative;font-size:16.5px}
.plans li::before{content:"";position:absolute;left:0;top:.4em;width:16px;height:16px;border-radius:50%;background:var(--green)}
.plans li::after{content:"";position:absolute;left:5px;top:.56em;width:5px;height:8px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
.strip{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 28px}
.strip span{background:var(--navy);color:#fff;border-radius:999px;padding:9px 18px;font-weight:700}
/* steps */
.steps{counter-reset:s;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;list-style:none;margin:0;padding:0}
.steps li{counter-increment:s;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px}
.steps li::before{content:counter(s);display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;font-weight:700;margin-bottom:12px}
.steps h3{font-size:20px;margin-bottom:6px}.steps p{margin:0;color:var(--muted);font-size:16.5px}
/* faq */
details{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px 20px;margin-bottom:12px}
summary{cursor:pointer;font-weight:700;font-size:19px}
details p{margin:10px 0 0;color:var(--muted)}
/* contact */
.contact{background:var(--navy);color:var(--on)}
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:44px}
.contact .sub{color:var(--on2)}
.cl{list-style:none;margin:0 0 24px;padding:0;display:grid;gap:14px}
.cl a{text-decoration:none;display:flex;flex-direction:column;background:var(--navy2);border-radius:14px;padding:14px 18px}
.cl small{color:var(--on2);font-size:14px}.cl strong{font-size:20px}
form{background:var(--navy2);border-radius:18px;padding:24px;display:grid;gap:14px}
label{font-size:15px;font-weight:700;color:var(--on2)}
input,textarea{width:100%;margin-top:6px;padding:12px 14px;border-radius:10px;border:1px solid #2C5578;background:#0B2A45;color:#fff;font:17px var(--f)}
textarea{min-height:110px;resize:vertical}
footer{background:#071A2B;color:var(--on2);padding:26px 0 calc(26px + env(safe-area-inset-bottom,0));font-size:15px}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px}
footer a{color:var(--on2)}
@media (max-width:900px){
 .hero .wrap,.about .wrap,.contact .wrap{grid-template-columns:1fr}
 .g4,.gal{grid-template-columns:repeat(2,1fr)}.g3,.steps{grid-template-columns:1fr}
 .nav ul{display:none}section{padding:56px 0}
}
@media (max-width:520px){.g2{grid-template-columns:1fr}.g4{grid-template-columns:1fr}.gal{gap:18px 12px}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
</style>
</head>
